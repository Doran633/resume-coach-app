LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=75
LLM_MAX_TOKENS=8192
LLM_THINKING=disabled
LLM_INPUT_PRICE_CNY_PER_MILLION=0
LLM_OUTPUT_PRICE_CNY_PER_MILLION=0
MAX_LLM_CALLS_PER_ATTEMPT=2

APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ANONYMOUS_COOKIE_NAME=resume_coach_identity
ANONYMOUS_COOKIE_SECRET=change-me
ANONYMOUS_COOKIE_MAX_AGE=7776000
DOWNLOAD_SIGNING_SECRET=change-me
DOWNLOAD_TOKEN_TTL_SECONDS=1200
IP_HASH_SECRET=change-me

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_DEGRADED_MAX_SECONDS=120
RATE_LIMIT_DRY_RUN=true
GENERATION_USER_LIMIT_5M=2
GENERATION_USER_LIMIT_1H=6
GENERATION_USER_LIMIT_1D=20
GENERATION_IP_LIMIT_5M=60
GENERATION_IP_LIMIT_1H=300
GENERATION_IP_LIMIT_1D=1000
MAX_CONCURRENT_GENERATIONS=5
MODEL_MAX_CONCURRENT_CALLS=5
MAX_GENERATION_QUEUE_SIZE=15
GENERATION_TASK_TTL_SECONDS=900
GENERATION_LEASE_SECONDS=120

MAX_RAW_INPUT_CHARS_SOFT=2000
MAX_RAW_INPUT_CHARS=4000
MAX_REQUEST_BODY_BYTES=131072
MAX_DAILY_LLM_CALLS=500
MAX_DAILY_LLM_TOKENS=5000000
MAX_DAILY_LLM_COST_CNY=200
LLM_COST_ALERT_RATIO=0.5
LLM_COST_WARNING_RATIO=0.8
LOG_RETENTION_DAYS=30
SECURITY_LOG_RETENTION_DAYS=90
DATABASE_URL=sqlite:///backend/data/resume_coach.db
